<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 第 3 个 Activity 要用隐式 Intent 调起系统相机，需要声明相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 声明不是必须依赖相机硬件，这样没有相机的设备也能安装 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 第 1 个二级 Activity：接收并显示 MainActivity 传过来的参数 -->
        <activity
            android:name=".FirstActivity"
            android:exported="false"
            android:label="@string/first_title"
            android:parentActivityName=".MainActivity" />

        <!-- 第 2 个二级 Activity：输入内容并返回给 MainActivity -->
        <activity
            android:name=".SecondActivity"
            android:exported="false"
            android:label="@string/second_title"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 第 3 个二级 Activity：隐式 Intent 调用系统相机拍照 -->
        <activity
            android:name=".ThirdActivity"
            android:exported="false"
            android:label="@string/third_title"
            android:parentActivityName=".MainActivity" />

        <!-- 第 4 个二级 Activity：秒表，横竖屏切换计时不中断 -->
        <activity
            android:name=".FourthActivity"
            android:exported="false"
            android:label="@string/fourth_title"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
